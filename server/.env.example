# ShopVerse Backend — environment variables
# Copy this file to ".env" and fill in real values.

# Server
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Auth
JWT_ACCESS_SECRET=change-this-to-a-long-random-string
JWT_REFRESH_SECRET=change-this-to-another-long-random-string
JWT_ACCESS_EXPIRES=60m
JWT_REFRESH_EXPIRES=7d

# Database
# Development uses SQLite (zero setup). Copy these blocks to switch to PostgreSQL:
#   DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/shopverse?schema=public"
DATABASE_URL="file:./dev.db"

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5